<!--pages/coffee-orders/coffee-orders.wxml-->
<view class="container">
  <!-- 咖啡余额卡片 -->
  <view class="balance-card">
    <view class="balance-item">
      <text class="balance-label">美式余额</text>
      <text class="balance-value">{{balance.americano}}杯</text>
    </view>
    <view class="balance-divider"></view>
    <view class="balance-item">
      <text class="balance-label">任意余额</text>
      <text class="balance-value">{{balance.any}}杯</text>
    </view>
  </view>

  <view wx:if="{{loading && orders.length === 0}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{orders.length === 0}}" class="empty-box">
    <text>暂无订单</text>
  </view>

  <view wx:else class="order-list">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <view class="order-header">
        <text class="order-no">{{item.order_no}}</text>
        <text class="order-status {{item.status === 'pending' ? 'status-pending' : item.status === 'paid' ? 'status-paid' : item.status === 'completed' ? 'status-completed' : 'status-cancelled'}}">
          {{item.status === 'pending' ? '待支付' : item.status === 'paid' ? '已支付' : item.status === 'completed' ? '已完成' : '已取消'}}
        </text>
      </view>
      <view class="order-items">
        <text wx:for="{{item.items}}" wx:for-item="product" wx:key="product_id">
          {{product.product_name}}({{product.temperature === 'cold' ? '冷' : '热'}}) x{{product.quantity}}
        </text>
      </view>
      <view class="order-footer">
        <text class="order-time">{{item.formattedTime}}</text>
        <text class="order-total">￥{{item.total_amount / 100}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="loading-more">
    <text>加载更多...</text>
  </view>

  <view wx:if="{{!hasMore && orders.length > 0}}" class="no-more">
    <text>没有更多了</text>
  </view>
</view>