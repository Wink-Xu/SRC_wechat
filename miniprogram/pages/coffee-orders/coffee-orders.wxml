<!--pages/coffee-orders/coffee-orders.wxml-->
<view class="container">
  <!-- 余额卡片 -->
  <view class="balance-card">
    <view class="balance-row">
      <view class="balance-item">
        <text class="balance-value">{{balance.americano}}</text>
        <text class="balance-label">美式余额</text>
      </view>
      <view class="balance-divider"></view>
      <view class="balance-item">
        <text class="balance-value">{{balance.any}}</text>
        <text class="balance-label">任意余额</text>
      </view>
    </view>
  </view>

  <!-- 通知提示 -->
  <view class="notify-bar" wx:if="{{!hasSubscribed}}" bindtap="requestSubscribe">
    <text class="notify-icon">🔔</text>
    <text class="notify-text">开启订单通知提醒</text>
    <text class="notify-arrow">›</text>
  </view>

  <view wx:if="{{loading && orders.length === 0}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{orders.length === 0}}" class="empty-box">
    <view class="empty-icon">📦</view>
    <text class="empty-text">暂无订单</text>
  </view>

  <view wx:else class="order-list">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <view class="order-top">
        <view class="order-no-group">
          <text class="order-no-label">订单号</text>
          <text class="order-no">{{item.order_no}}</text>
        </view>
        <view class="status-tag status-{{item.status}}">
          {{item.status === 'pending' ? '待支付' : item.status === 'paid' || item.status === 'processing' ? '已支付' : item.status === 'completed' ? '已完成' : '已取消'}}
        </view>
      </view>
      <view class="order-items">
        <text class="item-text" wx:for="{{item.items}}" wx:for-item="product" wx:key="product_id">
          {{product.product_name}} ×{{product.quantity}}
        </text>
      </view>
      <view class="order-bottom">
        <text class="order-time">{{item.formattedTime}}</text>
        <text class="order-price">￥{{item.total_amount / 100}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="loading-more">
    <text>加载更多...</text>
  </view>

  <view wx:if="{{!hasMore && orders.length > 0}}" class="no-more">
    <text>没有更多了</text>
  </view>
</view>