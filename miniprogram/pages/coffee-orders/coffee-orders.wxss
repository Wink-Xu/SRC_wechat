/* pages/coffee-orders/coffee-orders.wxss */
page {
  background: #F5F5F5;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.container {
  min-height: 100vh;
}

/* 余额卡片 */
.balance-card {
  background: #1A1A1A;
  padding: 32rpx 40rpx;
  margin: 24rpx 32rpx 20rpx;
  border-radius: 20rpx;
}

.balance-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.balance-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.balance-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

.balance-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

.balance-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 通知提示条 */
.notify-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFFFFF;
  margin: 0 32rpx 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.notify-icon {
  font-size: 32rpx;
  line-height: 1;
}

.notify-text {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.notify-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  line-height: 1;
}

/* 订单列表 */
.order-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-no-group {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-no-label {
  font-size: 20rpx;
  color: #999999;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  letter-spacing: 1rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.status-pending {
  background: #FFF3E0;
  color: #F57C00;
}

.status-paid {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-processing {
  background: #E3F2FD;
  color: #1976D2;
}

.status-completed {
  background: #F5F5F5;
  color: #666666;
}

.status-cancelled {
  background: #F5F5F5;
  color: #999999;
}

.order-items {
  margin-bottom: 20rpx;
}

.item-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.order-time {
  font-size: 22rpx;
  color: #999999;
}

.order-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* 加载和空状态 */
.loading-box, .empty-box, .loading-more, .no-more {
  text-align: center;
  padding: 60rpx 32rpx;
  color: #999999;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
}

.loading-more, .no-more {
  font-size: 24rpx;
  padding: 32rpx;
}