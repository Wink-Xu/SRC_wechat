/* pages/coffee-orders/coffee-orders.wxss */
page {
  background: #F8F8F8;
}

.container {
  min-height: 100vh;
  padding: 20rpx;
}

/* 余额卡片 */
.balance-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.balance-item {
  text-align: center;
}

.balance-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.balance-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-top: 8rpx;
}

.balance-divider {
  width: 1rpx;
  height: 60rpx;
  background: #F5F5F5;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 20rpx 20rpx;
}

.order-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.order-no {
  font-size: 22rpx;
  color: #999999;
}

.pickup-no {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.order-status {
  font-size: 24rpx;
  font-weight: 500;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.status-pending {
  background: #FFF3E0;
  color: #F57C00;
}

.status-paid {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-completed {
  background: #E3F2FD;
  color: #1976D2;
}

.status-cancelled {
  background: #F5F5F5;
  color: #999999;
}

.order-total {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.order-items {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.order-items text {
  display: block;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0F0F0;
}

.order-time {
  font-size: 22rpx;
  color: #999999;
}

.order-no {
  font-size: 22rpx;
  color: #999999;
}

.loading-box, .empty-box, .loading-more, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999999;
}