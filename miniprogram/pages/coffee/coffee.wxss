/* pages/coffee/coffee.wxss */
page {
  background: #F5F5F5;
  height: 100%;
  width: 100%;
}

.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 门店信息 - 固定在顶部 */
.store-info {
  background: #FFFFFF;
  padding: 32rpx;
  flex-shrink: 0;
  border-bottom: 1rpx solid #F0F0F0;
  cursor: pointer;
}

.store-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.store-address {
  font-size: 26rpx;
  color: #999999;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.map-icon {
  font-size: 24rpx;
  margin-left: 4rpx;
}

/* 分类 Tab - 固定在顶部 */
.category-tabs {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F0F0F0;
  height: 88rpx;
  flex-shrink: 0;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

/* 隐藏滚动条 */
.category-tabs::-webkit-scrollbar {
  display: none;
}

/* 有购物车时底部留白 */
.container.has-cart .product-list {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.tab-item {
  display: inline-block;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #666666;
  background: transparent;
  margin-right: 40rpx;
  position: relative;
  flex-shrink: 0;
}

.tab-item.active {
  color: #1A1A1A;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  height: 4rpx;
  background: #4A90E2;
  border-radius: 2rpx;
}

/* 商品列表 */
.product-list {
  flex: 1;
  height: calc(100vh - 220rpx);
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  background: #F5F5F5;
  width: 100%;
  min-height: 0;
}

.product-list-wrapper {
  padding: 24rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 分类标题 */
.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0 16rpx;
  margin-top: 16rpx;
  border-bottom: 1rpx solid #E8E8E8;
}

.category-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.category-count {
  font-size: 22rpx;
  color: #999999;
}

.products-in-category {
  display: flex;
  flex-direction: column;
}

.product-item {
  display: flex;
  align-items: center;
  background: #F7F4ED;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.product-content {
  flex: 1;
  padding-left: 24rpx;
}

.product-sub-name {
  font-size: 20rpx;
  color: #BBBBBB;
  margin-bottom: 6rpx;
  display: block;
}

.product-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
}

.add-btn {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn-text {
  color: #666666;
  font-size: 40rpx;
  font-weight: 100;
  line-height: 1;
}

/* 数量控制器 */
.quantity-controller {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quantity-controller .add-btn-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 300;
}

.quantity-num {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  min-width: 28rpx;
  text-align: center;
}

/* 底部购物车栏 - 按设计稿 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #F0F0F0;
}

.cart-left {
  display: flex;
  align-items: center;
}

.cart-icon-wrapper {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #E0E0E0;
  padding-right: 24rpx;
  margin-right: 24rpx;
}

.cart-icon {
  font-size: 36rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #4A90E2;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.cart-total-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.cart-checkout-btn {
  background: #333333;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  padding: 28rpx 64rpx;
  border-radius: 8rpx;
}

/* 选择规格弹窗 */
.spec-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-sheet {
  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  padding: 48rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 商品信息：左图右文 */
.spec-product-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding-right: 60rpx;
}

.spec-product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F8F8F8;
}

.spec-product-text {
  flex: 1;
  padding-left: 24rpx;
}

.spec-product-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.spec-product-sub {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
}

.spec-product-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
  line-height: 1.5;
}

.spec-close {
  position: absolute;
  top: 40rpx;
  right: 32rpx;
  font-size: 32rpx;
  color: #666666;
  padding: 8rpx;
}

/* 规格选择区块 */
.spec-section {
  margin-bottom: 32rpx;
}

.spec-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.spec-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

/* 数量选择 */
.spec-quantity {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  background: #F5F5F5;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333333;
}

.quantity-btn.disabled {
  color: #CCCCCC;
}

.quantity-num {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin: 0 32rpx;
  min-width: 40rpx;
  text-align: center;
}

/* 备注输入框 */
.spec-remark {
  width: 100%;
  min-height: 160rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333333;
  margin-top: 16rpx;
}

/* 选项区块 */
.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-option {
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
  border: 1rpx solid #E0E0E0;
}

.spec-option.active {
  background: #FFFFFF;
  color: #1A1A1A;
  border-color: #1A1A1A;
}

/* 加入购物车按钮 */
.spec-add-btn {
  background: #333333;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  padding: 32rpx 0;
  border-radius: 12rpx;
  margin-top: 48rpx;
}

/* 加载和空状态 */
.loading-box, .empty-box {
  text-align: center;
  padding: 120rpx;
  color: #999999;
  font-size: 28rpx;
}