/* pages/coffee/coffee.wxss */
page {
  background: #F5F5F5;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 有购物车时需要底部留白 */
.container.has-cart .product-grid {
  padding-bottom: 110rpx;
}

/* 门店信息 */
.store-info {
  background: #FFFFFF;
  padding: 24rpx 30rpx;
  margin-bottom: 12rpx;
}

.store-header {
  display: flex;
  flex-direction: column;
}

.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.store-address {
  font-size: 24rpx;
  color: #666666;
}

/* 分类 Tab - 胶囊样式 */
.category-tabs {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 16rpx 20rpx;
  flex-shrink: 0;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  border-radius: 32rpx;
  margin-right: 16rpx;
}

.tab-item.active {
  color: #FFFFFF;
  background: #1A1A1A;
  font-weight: 500;
}

/* 商品列表 */
.product-list {
  flex: 1;
  overflow: hidden;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx;
  gap: 16rpx;
}

.product-item {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 240rpx;
  background: #F0F0F0;
}

.product-content {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-temp-row {
  margin-bottom: 12rpx;
}

.product-temp {
  font-size: 22rpx;
  color: #999999;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.select-btn {
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 底部购物车栏 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.cart-left {
  display: flex;
  align-items: center;
}

.cart-icon-wrapper {
  position: relative;
  margin-right: 16rpx;
}

.cart-icon-box {
  width: 64rpx;
  height: 64rpx;
  background: #1A1A1A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon-text {
  font-size: 32rpx;
}

.cart-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #F44336;
  color: #FFFFFF;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-total {
  display: flex;
  align-items: baseline;
}

.total-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.cart-btn {
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
}

/* 温度选择弹窗 */
.temp-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.modal-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.modal-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 26rpx;
  color: #666666;
  display: block;
  margin-bottom: 16rpx;
}

.temp-btns {
  display: flex;
  gap: 16rpx;
}

.temp-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #F5F5F5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.temp-btn.active {
  background: #1A1A1A;
  color: #FFFFFF;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.cancel-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background: #F5F5F5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666666;
}

.confirm-btn {
  flex: 2;
  text-align: center;
  padding: 24rpx 0;
  background: #1A1A1A;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

/* 加载和空状态 */
.loading-box, .empty-box {
  text-align: center;
  padding: 100rpx;
  color: #999999;
}