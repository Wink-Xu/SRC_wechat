<!--pages/coffee/coffee.wxml-->
<view class="container {{cartCount > 0 ? 'has-cart' : ''}}">
  <!-- 门店信息 -->
  <view class="store-info" bindtap="openMap">
    <view class="store-info-left">
      <text class="store-name">{{storeName}}</text>
      <text class="store-address">{{storeAddress}}<text class="map-icon">📍</text></text>
    </view>
    <view class="shop-status-tag {{isShopOpen ? 'open' : 'closed'}}">
      {{isShopOpen ? '营业中' : '已打烊'}}
    </view>
  </view>

  <!-- 分类 Tab -->
  <view class="category-tabs">
    <view
      class="tab-item {{currentCategory === item.key ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="key"
      bindtap="scrollToCategory"
      data-category="{{item.key}}"
      id="tab-{{item.key}}"
    >
      {{item.name}}
    </view>
  </view>

  <!-- 商品列表 - 只支持上下滚动 -->
  <scroll-view class="product-list" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollToView}}" scroll-with-animation="true" bindscroll="onProductListScroll">
    <view wx:if="{{loading}}" class="loading-box">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{products.length === 0}}" class="empty-box">
      <text>暂无商品</text>
    </view>

    <view class="product-list-wrapper" wx:else>
      <!-- 按分类分组显示 -->
      <view wx:for="{{groupedProducts}}" wx:key="key" data-category="{{item.key}}">
        <view class="category-header" id="category-{{item.key}}">
          <text class="category-title">{{item.name}}</text>
          <text class="category-count">{{item.products.length}}款</text>
        </view>
        <view class="products-in-category">
          <view class="product-item" wx:for="{{item.products}}" wx:key="_id" wx:for-item="product" bindtap="goToDetail" data-id="{{product._id}}">
            <image class="product-image" src="{{product.display_image || '/images/coffee-default.png'}}" mode="aspectFill"></image>
            <view class="product-content">
              <text class="product-sub-name">{{product.sub_name}}</text>
              <text class="product-name">{{product.name}}</text>
              <text class="product-price">￥{{product.price / 100}}</text>
            </view>
            <!-- 根据购物车数量显示不同 UI -->
            <view wx:if="{{product.cartQuantity > 0}}" class="quantity-controller" catchtap="stopPropagation">
              <view class="add-btn" bindtap="decreaseCartQuantity" data-product="{{product}}">
                <text class="add-btn-text">−</text>
              </view>
              <text class="quantity-num">{{product.cartQuantity}}</text>
              <view class="add-btn" bindtap="increaseCartQuantity" data-product="{{product}}">
                <text class="add-btn-text">+</text>
              </view>
            </view>
            <view wx:else class="add-btn" catchtap="onAddToCart" data-product="{{product}}">
              <text class="add-btn-text">+</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar" wx:if="{{cartCount > 0}}" bindtap="goToCart">
    <view class="cart-left">
      <view class="cart-icon-wrapper">
        <image class="cart-icon-img" src="/images/gouwuche.png" mode="aspectFit"></image>
        <view class="cart-badge">{{cartCount}}</view>
      </view>
      <text class="cart-total-price">￥{{cartTotal / 100}}</text>
    </view>
    <view class="cart-checkout-btn">选好了</view>
  </view>

  <!-- 选择规格弹窗 -->
  <view class="spec-modal" wx:if="{{showTempModal}}">
    <view class="modal-mask" bindtap="closeTempModal"></view>
    <view class="modal-sheet">
      <!-- 商品信息：左图右文 -->
      <view class="spec-product-info">
        <image class="spec-product-image" src="{{selectedProduct.display_image || '/images/coffee-default.png'}}" mode="aspectFill"></image>
        <view class="spec-product-text">
          <text class="spec-product-name">{{selectedProduct.name}}</text>
          <text class="spec-product-sub">{{selectedProduct.sub_name || ''}}</text>
          <text class="spec-product-desc" wx:if="{{selectedProduct.description}}">{{selectedProduct.description}}</text>
        </view>
        <view class="spec-close" bindtap="closeTempModal">×</view>
      </view>

      <!-- 数量选择 -->
      <view class="spec-section">
        <view class="spec-section-header">
          <text class="spec-section-title">数量</text>
        </view>
        <view class="spec-quantity">
          <view class="quantity-btn {{quantity <= 1 ? 'disabled' : ''}}" bindtap="decreaseQuantity">-</view>
          <text class="quantity-num">{{quantity}}</text>
          <view class="quantity-btn" bindtap="increaseQuantity">+</view>
        </view>
      </view>

      <!-- 备注输入（仅非套餐商品显示） -->
      <view class="spec-section" wx:if="{{!selectedProduct.is_recharge}}">
        <text class="spec-section-title">备注（可选）</text>
        <textarea class="spec-remark" placeholder="例如：少糖、去冰、加浓等" maxlength="100" value="{{remark}}" bindinput="onRemarkInput"></textarea>
      </view>

      <!-- 加入购物车按钮 -->
      <view class="spec-add-btn" bindtap="confirmAdd">添加至购物车</view>
    </view>
  </view>
</view>