<!--pages/coffee/coffee.wxml-->
<view class="container {{cartCount > 0 ? 'has-cart' : ''}}">
  <!-- 门店信息 -->
  <view class="store-info">
    <view class="store-header">
      <text class="store-name">{{storeName}}</text>
      <text class="store-address">{{storeAddress}}</text>
    </view>
  </view>

  <!-- 分类 Tab -->
  <scroll-view class="category-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="tab-item {{currentCategory === item.key ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="key"
      bindtap="switchCategory"
      data-category="{{item.key}}"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 商品列表 -->
  <scroll-view class="product-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="loading-box">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{products.length === 0}}" class="empty-box">
      <text>暂无商品</text>
    </view>

    <view class="product-grid" wx:else>
      <view class="product-item" wx:for="{{products}}" wx:key="_id">
        <image class="product-image" src="{{item.display_image || '/images/coffee-default.png'}}" mode="aspectFill"></image>
        <view class="product-content">
          <text class="product-name">{{item.name}}</text>
          <view class="product-temp-row">
            <text class="product-temp" wx:if="{{item.temperature === 'both'}}">冷/热</text>
            <text class="product-temp" wx:elif="{{item.temperature === 'cold_only'}}">仅冷</text>
            <text class="product-temp" wx:elif="{{item.temperature === 'hot_only'}}">仅热</text>
          </view>
          <view class="product-footer">
            <text class="product-price">￥{{item.price / 100}}</text>
            <view class="select-btn" bindtap="onAddToCart" data-product="{{item}}">
              <text>选规格</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar" wx:if="{{cartCount > 0}}">
    <view class="cart-left" bindtap="goToCart">
      <view class="cart-icon-wrapper">
        <view class="cart-icon-box">
          <text class="cart-icon-text">🛒</text>
        </view>
        <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
      </view>
      <view class="cart-total">
        <text class="total-price">￥{{cartTotal / 100}}</text>
      </view>
    </view>
    <view class="cart-btn" bindtap="goToCart">去结算</view>
  </view>

  <!-- 温度选择弹窗 -->
  <view class="temp-modal" wx:if="{{showTempModal}}">
    <view class="modal-mask" bindtap="closeTempModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">{{selectedProduct.name}}</text>
        <text class="modal-price">￥{{selectedProduct.price / 100}}</text>
      </view>
      <view class="modal-section">
        <text class="section-label">温度</text>
        <view class="temp-btns">
          <view class="temp-btn {{selectedTemp === 'cold' ? 'active' : ''}}" bindtap="selectTemp" data-temp="cold">冷</view>
          <view class="temp-btn {{selectedTemp === 'hot' ? 'active' : ''}}" bindtap="selectTemp" data-temp="hot" wx:if="{{selectedProduct.temperature === 'both' || selectedProduct.temperature === 'hot_only'}}">热</view>
        </view>
      </view>
      <view class="modal-actions">
        <view class="cancel-btn" bindtap="closeTempModal">取消</view>
        <view class="confirm-btn" bindtap="confirmAdd">加入购物车</view>
      </view>
    </view>
  </view>
</view>