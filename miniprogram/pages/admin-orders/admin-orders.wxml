<view class="container">
  <!-- 状态选项卡 -->
  <view class="status-tabs">
    <view
      class="tab-item {{currentStatus === item.key ? 'active' : ''}}"
      wx:for="{{statusTabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >
      <text>{{item.title}}</text>
      <text wx:if="{{item.key !== 'completed' && tabCounts[item.key] > 0}}" class="tab-badge">{{tabCounts[item.key] > 99 ? '99+' : tabCounts[item.key]}}</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view wx:if="{{loading && orders.length === 0}}" class="loading-box">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{orders.length === 0}}" class="empty-box">
      <text class="empty-text">暂无订单</text>
    </view>

    <view class="order-card" wx:for="{{orders}}" wx:key="_id">
      <view class="card-top">
        <text class="order-no">{{item.order_no}}</text>
        <text class="status-tag status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="card-body">
        <view class="info-line">
          <text class="user-name">{{item.address.name}}</text>
          <text class="user-phone">{{item.address.phone}}</text>
        </view>
        <view class="info-line">
          <text class="label">商品</text>
          <text class="value">{{item.product_name}} x{{item.quantity}}</text>
          <text class="price" wx:if="{{item.pay_method === 'points'}}">{{item.total_points}}积分</text>
          <text class="price" wx:else>¥{{item.cashPriceYuan}}</text>
        </view>
        <view class="info-line" wx:if="{{item.address}}">
          <text class="label">地址</text>
          <text class="value addr">{{item.address.province}}{{item.address.city}}{{item.address.district}}{{item.address.detail}}</text>
        </view>
        <view class="info-line" wx:if="{{item.express_company || item.express_no}}">
          <text class="label">物流</text>
          <text class="value">{{item.express_company}} {{item.express_no}}</text>
        </view>
      </view>

      <view class="card-bottom">
        <text class="order-time">{{item.formattedTime}}</text>

        <view class="actions">
          <button
            wx:if="{{item.status === 'paid'}}"
            class="btn btn-primary"
            data-id="{{item._id}}"
            bindtap="showShipModal"
          >发货</button>

          <view wx:elif="{{item.status === 'refund_requested'}}" class="btn-group">
            <button class="btn btn-outline" data-id="{{item._id}}" bindtap="handleApproveRefund">同意退货</button>
            <button class="btn btn-danger" data-id="{{item._id}}" bindtap="handleDirectRefund">直接退款</button>
          </view>

          <button
            wx:elif="{{item.status === 'refund_approved'}}"
            class="btn btn-outline"
            data-id="{{item._id}}"
            bindtap="handleConfirmReturn"
          >确认收货</button>

          <button
            wx:elif="{{item.status === 'returned'}}"
            class="btn btn-danger"
            data-id="{{item._id}}"
            bindtap="handleProcessRefund"
          >确认退款</button>
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="loading-more">
      <text>加载更多...</text>
    </view>

    <view wx:if="{{!hasMore && orders.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 发货弹窗 -->
  <view class="modal-mask" wx:if="{{showShipModal}}">
    <view class="modal-content" catchtap="stopTap">
      <view class="modal-header">
        <text class="modal-title">填写物流信息</text>
        <text class="modal-close" bindtap="closeShipModal">×</text>
      </view>
      <view class="modal-body">
        <view class="field">
          <text class="field-label">快递公司</text>
          <input class="field-input" placeholder="如: 顺丰、中通" value="{{expressCompany}}" bindinput="onExpressCompanyInput" />
        </view>
        <view class="field">
          <text class="field-label">快递单号</text>
          <input class="field-input" placeholder="请输入快递单号" value="{{expressNo}}" bindinput="onExpressNoInput" />
        </view>
      </view>
      <view class="modal-ft">
        <button class="btn btn-cancel" bindtap="closeShipModal">取消</button>
        <button class="btn btn-primary" bindtap="confirmShip">确认发货</button>
      </view>
    </view>
  </view>
</view>
