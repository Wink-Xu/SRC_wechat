/* pages/coffee-order-detail/coffee-order-detail.wxss */
page {
  background: #F8F8F8;
}

.container {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 状态卡片 */
.status-card {
  background: linear-gradient(135deg, #1A1A1A 0%, #333333 100%);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.status-icon {
  display: block;
  font-size: 80rpx;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  line-height: 1;
}

.status-text {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.status-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 卡片通用样式 */
.products-card, .info-card, .timeline-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* 商品列表 */
.product-list {
  margin-bottom: 20rpx;
}

.product-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.product-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.product-temp {
  font-size: 22rpx;
  color: #999999;
  padding: 4rpx 12rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
}

.product-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.product-qty {
  font-size: 26rpx;
  color: #999999;
}

.product-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  min-width: 140rpx;
  text-align: right;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #E0E0E0;
}

.total-label {
  font-size: 28rpx;
  color: #666666;
}

.total-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* 信息卡片 */
.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
}

.info-value {
  font-size: 26rpx;
  color: #1A1A1A;
  text-align: right;
  max-width: 50%;
}

.info-value-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-value.openid {
  font-size: 22rpx;
  word-break: break-all;
}

.copy-btn {
  font-size: 24rpx;
  color: #4A90E2;
  padding: 4rpx 16rpx;
  background: #E8F4FF;
  border-radius: 12rpx;
}

/* 时间线 */
.timeline {
  padding: 20rpx 0;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 40rpx;
  bottom: 0;
  width: 2rpx;
  background: #E0E0E0;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E0E0E0;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.timeline-dot.active {
  background: #4A90E2;
}

.timeline-content {
  flex: 1;
  padding: 0 0 24rpx;
}

.timeline-text {
  display: block;
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.timeline-time {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* 管理员操作 */
.admin-actions {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}

.pending-btn {
  background: #1976D2;
  color: #FFFFFF;
}

.processing-btn {
  background: #2E7D32;
  color: #FFFFFF;
}

.cancel-btn {
  background: #F5F5F5;
  color: #666666;
}

/* 用户取消 */
.user-action {
  margin-top: 32rpx;
}

.cancel-order-btn {
  width: 100%;
  background: #F5F5F5;
  color: #666666;
  font-size: 30rpx;
  padding: 28rpx 0;
  border-radius: 12rpx;
  border: none;
}

/* 加载状态 */
.loading-box {
  text-align: center;
  padding: 120rpx 32rpx;
  color: #999999;
  font-size: 28rpx;
}
