/* pages/contact-us/contact-us.wxss */

.page {
  min-height: 100vh;
  background: #F5F5F7;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
}

/* ===== Slogan Card ===== */
.slogan-card {
  background: #1A1A1A;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.slogan-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #E91E9B;
  letter-spacing: 6rpx;
  line-height: 1.6;
}

/* ===== Info Card ===== */
.info-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  text-align: right;
}

.info-divider {
  height: 1rpx;
  background: #F2F2F2;
  margin: 0;
}

/* ===== Customer Service Button ===== */
.cs-btn-wrap {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.cs-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  text-align: center;
  padding: 0;
}

.cs-btn::after {
  border: none;
}
