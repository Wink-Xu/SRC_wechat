/* pages/about-us/about-us.wxss */

.page {
  min-height: 100vh;
  background: #FFFFFF;
  padding: 32rpx 32rpx 60rpx;
}

.images-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.about-image {
  width: 100%;
  border-radius: 16rpx;
  background: #F5F5F5;
}

.about-text {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.9;
  display: block;
}
