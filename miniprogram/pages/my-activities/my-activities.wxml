<!--pages/my-activities/my-activities.wxml-->
<view class="container">
  <view wx:if="{{loading}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <!-- Tab 切换 -->
    <view class="tabs">
      <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
        <text>全部 ({{checkedInActivities.length + registeredActivities.length}})</text>
      </view>
      <view class="tab {{currentTab === 'checked' ? 'active' : ''}}" bindtap="switchTab" data-tab="checked">
        <text>已签到 ({{checkedInActivities.length}})</text>
      </view>
    </view>

    <!-- 全部活动列表 -->
    <view wx:if="{{currentTab === 'all'}}" class="activity-list">
      <view wx:if="{{checkedInActivities.length === 0 && registeredActivities.length === 0}}" class="empty-box">
        <image class="empty-icon" src="/images/empty.png" mode="aspectFit"></image>
        <text class="empty-text">暂无活动记录</text>
      </view>

      <view wx:elif="{{registeredActivities.length > 0}}" class="section-block">
        <text class="section-title">待签到</text>
        <view
          class="activity-card"
          wx:for="{{registeredActivities}}"
          wx:key="_id"
          bindtap="goToDetail"
          data-id="{{item._id}}"
        >
          <view class="cover-image">
            <image class="cover-img" src="{{item.display_cover_image || item.cover_image || '/images/default-product.png'}}" mode="aspectFill"></image>
          </view>
          <view class="activity-info">
            <view class="title-row">
              <text class="activity-title">{{item.title}}</text>
              <text class="status-tag pending">待签到</text>
            </view>
            <view class="activity-meta-row">
              <text class="meta-text">{{item.formattedTime}}</text>
              <text class="meta-divider">|</text>
              <text class="meta-text">{{item.location}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="section-block">
        <text class="section-title">已签到</text>
        <view
          class="activity-card"
          wx:for="{{checkedInActivities}}"
          wx:key="_id"
          bindtap="goToDetail"
          data-id="{{item._id}}"
        >
          <view class="cover-image">
            <image class="cover-img" src="{{item.display_cover_image || item.cover_image || '/images/default-product.png'}}" mode="aspectFill"></image>
          </view>
          <view class="activity-info">
            <view class="title-row">
              <text class="activity-title">{{item.title}}</text>
              <text class="status-tag checked">已签到</text>
            </view>
            <view class="activity-meta-row">
              <text class="meta-text">{{item.formattedTime}}</text>
              <text class="meta-divider">|</text>
              <text class="meta-text">{{item.location}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 仅已签到 -->
    <view wx:elif="{{currentTab === 'checked'}}" class="activity-list">
      <view wx:if="{{checkedInActivities.length === 0}}" class="empty-box">
        <image class="empty-icon" src="/images/empty.png" mode="aspectFit"></image>
        <text class="empty-text">暂未签到任何活动</text>
      </view>

      <view
        class="activity-card"
        wx:for="{{checkedInActivities}}"
        wx:key="_id"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <view class="cover-image">
          <image class="cover-img" src="{{item.display_cover_image || item.cover_image || '/images/default-product.png'}}" mode="aspectFill"></image>
        </view>
        <view class="activity-info">
          <text class="activity-title">{{item.title}}</text>
          <view class="activity-meta-row">
            <text class="meta-text">{{item.formattedTime}}</text>
            <text class="meta-divider">|</text>
            <text class="meta-text">{{item.location}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
