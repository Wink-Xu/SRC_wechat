/* pages/apply-membership/apply-membership.wxss - On Running 极简风格 */

.container {
  min-height: 100vh;
  background-color: var(--background);
  padding: 40rpx;
}

.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

.form-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #F0F0F0;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.avatar-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder-text {
  font-size: 56rpx;
  color: #D4A574;
  font-weight: 300;
  line-height: 1;
}

.avatar-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 60rpx 60rpx;
}

.avatar-hint text {
  font-size: 18rpx;
  color: #FFFFFF;
}

.form-input {
  height: 92rpx;
  padding: 0 26rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  border: 1rpx solid transparent;
}

.form-input:focus {
  border-color: #1A1A1A;
}

.form-input::placeholder {
  color: #999999;
}

.btn-submit {
  height: 92rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  border-radius: 46rpx;
}

.btn-submit::after {
  border: none;
}

.tips {
  text-align: center;
  padding: 24rpx 0;
}

.tips text {
  font-size: 22rpx;
  color: #999999;
}
