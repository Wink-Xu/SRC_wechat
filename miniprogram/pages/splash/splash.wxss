.splash {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #FFFFFF;
}

.splash-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.splash-logo {
  width: 280rpx;
  height: 100rpx;
  animation: logoFade 0.8s ease-out;
}

@keyframes logoFade {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.splash-line {
  width: 80rpx;
  height: 2rpx;
  background: #E0E0E0;
  margin: 48rpx 0 40rpx;
  animation: lineFade 0.6s ease-out 0.3s both;
}

@keyframes lineFade {
  0% {
    opacity: 0;
    width: 0;
  }
  100% {
    opacity: 1;
    width: 80rpx;
  }
}

.splash-loader {
  display: flex;
  gap: 12rpx;
  animation: loaderFade 0.6s ease-out 0.5s both;
}

@keyframes loaderFade {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.loader-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #1A1A1A;
}

.dot1 {
  animation: dotBounce 1.2s ease-in-out infinite;
}

.dot2 {
  animation: dotBounce 1.2s ease-in-out 0.15s infinite;
}

.dot3 {
  animation: dotBounce 1.2s ease-in-out 0.3s infinite;
}

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0.5);
    opacity: 0.2;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}
