<!--pages/activity-detail/activity-detail.wxml-->
<view class="container">
  <view wx:if="{{loading}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <!-- 非团员查看往期活动提示 -->
  <block wx:elif="{{activity && activity.status === 'ended' && !isMember}}">
    <view class="permission-denied">
      <image class="denied-icon" src="/images/logo.jpg" mode="aspectFill"></image>
      <text class="denied-title">加入 SRC，一起奔跑</text>
      <text class="denied-desc">成为团员后可查看往期活动详情</text>
      <button class="btn-apply" bindtap="goToApply">申请入团</button>
    </view>
  </block>

  <block wx:elif="{{activity}}">
    <!-- 正在报名的活动：显示完整信息 -->
    <block wx:if="{{activity.status === 'ongoing'}}">
      <!-- 封面图头部 -->
      <view class="cover-header cover-ongoing">
        <image class="cover-image" src="{{activity.cover_image || '/images/default-product.png'}}" mode="widthFix"></image>
        <view class="cover-content">
          <view class="points-tag">
            <text class="points-value">+{{activity.points}}</text>
            <text class="points-label">积分</text>
          </view>
          <text class="activity-title">{{activity.title}}</text>
        </view>
      </view>

      <!-- 活动详情 -->
      <view class="section-card">
        <view class="card-header-simple">
          <text class="card-title">活动详情</text>
        </view>
        <text class="desc-text">{{activity.description}}</text>
      </view>

      <!-- 活动信息列表 -->
      <view class="info-grid">
        <view class="info-cell">
          <text class="info-label">活动时间</text>
          <text class="info-value">{{activity.formattedTime}}</text>
        </view>
        <view class="info-cell">
          <text class="info-label">集合地点</text>
          <view class="info-value location-value" bindtap="openLocation">
            <text>{{activity.location}}</text>
            <text class="location-icon">▶</text>
          </view>
        </view>
        <view class="info-cell" wx:if="{{activity.registration_deadline}}">
          <text class="info-label">报名截止</text>
          <text class="info-value">{{activity.formattedRegistrationDeadline}}</text>
        </view>
        <view class="info-cell" wx:if="{{activity.dress_code}}">
          <text class="info-label">DressCode</text>
          <text class="info-value">{{activity.dress_code}}</text>
        </view>
        <view class="info-cell" wx:if="{{recurringText}}">
          <text class="info-label">重复周期</text>
          <text class="info-value">{{recurringText}}</text>
        </view>
        <!-- 报名条件 -->
        <view class="info-cell" wx:if="{{activity.registration_fee_type || activity.member_only}}">
          <text class="info-label">报名条件</text>
          <view class="info-value registration-condition">
            <text wx:if="{{activity.member_only}}" class="condition-tag member-only">仅团员</text>
            <text wx:if="{{activity.registration_fee_type === 'points'}}" class="condition-tag fee">{{activity.registration_fee}}积分</text>
            <text wx:elif="{{activity.registration_fee_type === 'cash'}}" class="condition-tag fee">¥{{activity.registration_fee_yuan || activity.registration_fee}}</text>
            <text wx:else class="condition-tag free">免费</text>
            <text wx:if="{{activity.refund_policy === 'anytime'}}" class="condition-tag refund">随时退</text>
            <text wx:elif="{{activity.refund_policy === 'half'}}" class="condition-tag refund">退50%</text>
          </view>
        </view>
      </view>

      <!-- 已报名团员 -->
      <view class="section-card">
        <view class="card-header-simple">
          <text class="card-title">已报名 <text class="highlight-count">{{activity.registered_count || 0}}/{{activity.quota}}人</text></text>
          <view wx:if="{{activity.waitlist_count > 0}}" class="waitlist-hint">候补 {{activity.waitlist_count}}人</view>
          <view class="view-all-btn" bindtap="viewParticipants" wx:if="{{participants.length > 0}}">
            <text>全部</text>
            <image class="arrow-icon" src="/images/arrow-right.png"></image>
          </view>
        </view>
        <view class="participants-list" wx:if="{{participants.length > 0}}">
          <view class="participant-item {{item.check_in_status === 'checked_in' ? 'checked-in' : ''}}" wx:for="{{participants}}" wx:for-limit="6" wx:key="_id">
            <image class="participant-avatar" src="{{item.avatar || '/images/default-avatar.png'}}" bindtap="previewParticipantAvatar" data-index="{{index}}"></image>
            <text class="participant-name">{{item.nickname}}</text>
          </view>
        </view>
        <view class="no-participants" wx:else>
          <text>暂无团员报名</text>
        </view>
      </view>

      <!-- 候补名单 -->
      <view class="section-card" wx:if="{{waitlistParticipants.length > 0}}">
        <view class="card-header-simple">
          <text class="card-title">候补名单</text>
          <text>{{waitlistParticipants.length}}人</text>
        </view>
        <view class="participants-list">
          <view class="participant-item" wx:for="{{waitlistParticipants}}" wx:key="_id">
            <image class="participant-avatar" src="{{item.avatar || '/images/default-avatar.png'}}" bindtap="previewWaitlistAvatar" data-index="{{index}}"></image>
            <text class="participant-name">{{item.nickname}}</text>
          </view>
        </view>
      </view>

      <!-- 底部操作区 -->
      <view class="footer-actions">
        <view class="footer-row">
          <button class="btn-contact-icon" open-type="contact">
            <image class="contact-icon-img" src="/images/xinxi.png" mode="aspectFill"></image>
          </button>

          <view class="footer-main">
            <!-- 报名已截止 -->
            <block wx:if="{{registrationClosed && !isRegistered}}">
              <view class="registration-closed">
                <text>报名已截止</text>
              </view>
            </block>

            <!-- 未报名用户显示报名/候补按钮 -->
            <block wx:elif="{{!isRegistered && !isWaitlisted}}">
              <button class="btn-register {{isFull ? 'btn-waitlist' : ''}}" bindtap="handleRegister">{{isFull ? '候补报名' : '立即报名'}}</button>
            </block>

            <!-- 已加入候补 -->
            <block wx:elif="{{isWaitlisted}}">
              <view class="checked-in-badge">
                <text>已加入候补</text>
              </view>
            </block>

            <!-- 已报名用户显示取消报名按钮 -->
            <block wx:elif="{{isRegistered && registration.check_in_status !== 'checked_in'}}">
              <button class="btn-cancel-register" bindtap="handleCancelRegistration">取消报名</button>
            </block>

            <!-- 已签到用户显示已签到标识 -->
            <block wx:if="{{isRegistered && registration.check_in_status === 'checked_in'}}">
              <view class="checked-in-badge">
                <image class="badge-icon" src="/images/check.png"></image>
                <text>已签到</text>
              </view>
            </block>
          </view>
        </view>
      </view>
    </block>

    <!-- 往期活动：只显示详情和照片 -->
    <block wx:else>
      <!-- 封面图头部 -->
      <view class="cover-header past-cover">
        <image class="cover-image" src="{{activity.cover_image || '/images/default-product.png'}}" mode="widthFix"></image>
        <view class="cover-actions" wx:if="{{canUploadPhotos}}">
          <button class="btn-change-cover" bindtap="changeCoverImage">更换封面</button>
        </view>
        <view class="cover-content">
          <text class="activity-title">{{activity.title}}</text>
        </view>
      </view>

      <!-- 活动详情 -->
      <view class="section-card">
        <view class="card-header-simple">
          <text class="card-title">活动详情</text>
        </view>
        <text class="desc-text">{{activity.description}}</text>
      </view>

      <!-- 活动照片 -->
      <view class="section-card">
        <view class="card-header-simple">
          <text class="card-title">活动照片</text>
          <view class="photo-actions">
            <view class="upload-btn" wx:if="{{canUploadPhotos && !isSelectMode}}" bindtap="uploadPhotos">
              <text>上传</text>
            </view>
            <view class="edit-btn" wx:if="{{canUploadPhotos && activity.photos && activity.photos.length > 0 && !isSelectMode}}" bindtap="enterSelectMode">
              <text>编辑</text>
            </view>
            <block wx:if="{{isSelectMode}}">
              <view class="select-btns">
                <text class="select-btn" bindtap="selectAll">全选</text>
                <text class="select-btn" bindtap="cancelSelectMode">取消</text>
                <text class="select-btn delete" bindtap="deleteSelectedPhotos" wx:if="{{selectedPhotos.length > 0}}">删除({{selectedPhotos.length}})</text>
              </view>
            </block>
          </view>
        </view>
        <view class="photos-grid" wx:if="{{activity.photos && activity.photos.length > 0}}">
          <view
            class="photo-item {{isSelectMode && selectedPhotos.includes(index) ? 'selected' : ''}}"
            wx:for="{{activity.photos}}"
            wx:key="*this"
          >
            <image class="photo-img" src="{{item}}" mode="aspectFill" bindtap="{{isSelectMode ? 'toggleSelectPhoto' : 'previewImage'}}" data-index="{{index}}"></image>
            <view class="photo-delete" wx:if="{{canUploadPhotos && !isSelectMode}}" bindtap="deletePhoto" data-index="{{index}}">
              <text>×</text>
            </view>
            <view class="photo-check" wx:if="{{isSelectMode && selectedPhotos.includes(index)}}">
              <text>✓</text>
            </view>
          </view>
        </view>
        <view class="no-photos" wx:else>
          <text>暂无照片</text>
        </view>
      </view>

      <!-- 已签到团员 -->
      <view class="section-card" wx:if="{{checkedInParticipants.length > 0}}">
        <view class="card-header-simple">
          <text class="card-title">已签到团员</text>
          <text class="checked-in-count">{{checkedInParticipants.length}}人</text>
        </view>
        <view class="checked-in-list">
          <view class="checked-in-item" wx:for="{{checkedInParticipants}}" wx:key="_id">
            <image class="checked-in-avatar" src="{{item.avatar || '/images/default-avatar.png'}}" bindtap="previewCheckedInAvatar" data-index="{{index}}"></image>
            <text class="checked-in-name">{{item.nickname}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>

<!-- 封面调整组件 -->
<!-- 游客报名手机号弹窗 -->
<view class="phone-modal" wx:if="{{showPhoneModal}}">
  <view class="phone-modal-mask" bindtap="cancelPhoneInput"></view>
  <view class="phone-modal-content">
    <view class="phone-modal-header">
      <text class="phone-modal-title">填写手机号</text>
      <text class="phone-modal-close" bindtap="cancelPhoneInput">×</text>
    </view>
    <view class="phone-modal-body">
      <text class="phone-modal-hint">游客报名需填写手机号以便联系</text>
      <input
        class="phone-input"
        type="number"
        placeholder="请输入手机号"
        maxlength="11"
        value="{{guestPhone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="phone-modal-footer">
      <button class="phone-cancel-btn" bindtap="cancelPhoneInput">取消</button>
      <button class="phone-confirm-btn" bindtap="confirmPhone">确认报名</button>
    </view>
  </view>
</view>