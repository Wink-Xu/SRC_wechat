/* pages/activities/activities.wxss - On Running 极简风格 */

page {
  --primary: #1A1A1A;
  --success: #2E7D32;
  --warning: #CC7722;
  --danger: #F44336;
  --gray: #999999;
  --text: #1A1A1A;
  --text-light: #666666;
  --bg: var(--background);
}

.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 120rpx;
}

/* 分区 */
.section {
  padding: 20rpx 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A1A1A;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--gray);
}

/* 正在报名 - 活动卡片 */
.activity-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A1A1A;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.activity-info {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  opacity: 0.7;
}

.info-item text {
  font-size: 26rpx;
  color: var(--text-light);
}

.info-item .deadline-text {
  color: var(--warning);
  font-size: 24rpx;
}

.activity-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--bg);
}

.quota-info {
  font-size: 26rpx;
}

.registered-count {
  font-weight: 500;
  color: #1A1A1A;
}

.quota-text {
  color: var(--gray);
}

.points-info {
  display: flex;
  align-items: baseline;
}

.points-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.points-label {
  font-size: 22rpx;
  color: var(--gray);
  margin-left: 4rpx;
}

/* 往期活动 - 封面图卡片 */
.past-card {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.cover-image {
  position: relative;
  width: 100%;
  /* 16:9 比例（往期活动） */
  height: 0;
  padding-bottom: 56.25%;
  overflow: hidden;
}

/* 正在报名的活动：原始比例 */
.cover-image.cover-ongoing {
  height: auto;
  padding-bottom: 0;
  background: #F0F0F0;
}

.cover-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-ongoing .cover-img {
  position: relative;
  height: auto;
}

/* 右下角标签 */
.corner-tag {
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.7);
}

.past-info {
  padding: 24rpx;
}

.past-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.meta-count {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 日期行 - 时间左对齐，状态标签右对齐 */
.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

/* 状态标签 - 行内显示 */
.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-tag.ongoing {
  background: #1A1A1A;
  color: #FFFFFF;
}

.status-tag.ended {
  background: #F5F5F5;
  color: #999999;
}

.recurring-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
  background: #F5F5F5;
  color: #1A1A1A;
  margin-left: 8rpx;
  vertical-align: middle;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.past-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 标题左部 - 标题和重复标签 */
.title-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  margin-right: 16rpx;
}

/* 标题行 - 标题和报名人数同一行 */
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.title-row .past-title {
  flex: 1;
  margin-bottom: 0;
  margin-right: 16rpx;
}

.title-row .meta-count {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.past-date {
  display: block;
  font-size: 24rpx;
  color: var(--gray);
}

/* 加载状态 */
.loading-box,
.loading-more {
  text-align: center;
  padding: 40rpx;
  color: var(--gray);
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: var(--gray);
  font-size: 24rpx;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  color: var(--gray);
  font-size: 28rpx;
}

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.tag-primary {
  background: #1A1A1A;
  color: #FFFFFF;
}

.tag-success {
  background: #F5F9F5;
  color: var(--success);
  border: 1rpx solid #E5F0E5;
}

.tag-warning {
  background: #F5F5F0;
  color: var(--warning);
  border: 1rpx solid #E5E5E0;
}

.tag-secondary {
  background: #F5F5F5;
  color: var(--gray);
  border: 1rpx solid #E0E0E0;
}

.tag-error {
  background: #FDF5F5;
  color: var(--danger);
  border: 1rpx solid #F0E5E5;
}
