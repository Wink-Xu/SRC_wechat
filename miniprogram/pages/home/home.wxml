<view class="nav-bar" style="padding-top: {{navBarTop}}px;">
  <image class="nav-logo" src="/images/logo.jpg" mode="aspectFill"></image>
  <text class="nav-title">Sunday Running Club</text>
</view>

<view class="page" wx:if="{{loaded}}">
  <!-- 日期 -->
  <view class="date-line">
    <text class="date-text">{{today}}</text>
  </view>

  <!-- 公告 -->
  <view wx:if="{{announcementCards.length > 0}}">
    <view class="section-head">
      <text class="section-title">广而告之</text>
    </view>
    <view class="announcement-wrap">
      <view class="announcement-card" wx:for="{{announcementCards}}" wx:key="index">
        <image class="scroll-card-image-wide" src="{{item.image}}" mode="widthFix" bindtap="previewAnnouncementImage"></image>
        <text class="scroll-card-title" wx:if="{{item.title}}">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 往期精彩 -->
  <view wx:if="{{highlightCards.length > 0}}">
    <view class="section-head">
      <text class="section-title">往期精彩</text>
    </view>
    <view class="scroll-area">
      <view class="scroll-card" wx:for="{{highlightCards}}" wx:for-index="idx" wx:key="activityId">
        <image class="scroll-card-image" src="{{item.image}}" mode="aspectFill" bindtap="goToActivity" data-id="{{item.activityId}}"></image>
        <text class="scroll-card-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 关于我们 -->
  <view wx:if="{{aboutImage}}">
    <view class="section-head">
      <text class="section-title">关于我们</text>
    </view>
    <view class="about-wrap">
      <image class="about-cover" src="{{aboutImage}}" mode="aspectFill" bindtap="goToAboutUs"></image>
    </view>
  </view>

  <!-- 联系我们 -->
  <view class="section-head">
    <text class="section-title">联系我们</text>
  </view>
  <view class="contact-body">
    <text class="contact-sub">于SRC之壤，育更好之我。</text>
    <button class="contact-btn" open-type="contact">
      <image class="btn-chat-icon" src="/images/kefu-2.png" mode="aspectFill"></image>
      <text>戳我唠嗑</text>
    </button>
  </view>
</view>

<!-- 加载骨架 -->
<view class="page" wx:else>
  <view style="padding: 32rpx;">
    <view style="width: 100%; height: 340rpx; background: #F5F5F5; border-radius: 20rpx; margin-bottom: 24rpx;"></view>
    <view style="width: 60%; height: 32rpx; background: #F5F5F5; border-radius: 8rpx; margin-bottom: 48rpx;"></view>
    <view style="width: 100%; height: 340rpx; background: #F5F5F5; border-radius: 20rpx; margin-bottom: 24rpx;"></view>
    <view style="width: 80%; height: 32rpx; background: #F5F5F5; border-radius: 8rpx;"></view>
  </view>
</view>
