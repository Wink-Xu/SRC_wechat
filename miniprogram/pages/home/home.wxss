/* pages/home/home.wxss */
.container {
  min-height: 100vh;
  background: #F8F8F8;
  padding-bottom: 60rpx;
}

/* Banner */
.banner {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
}

.club-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.club-slogan {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  display: block;
}

/* Section */
.section {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  gap: 16rpx;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
}

.section-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  transition: transform 0.3s;
  transform: rotate(90deg);
}

.section.expanded {
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-body {
  padding: 0 28rpx 32rpx;
}

.section-cover {
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.section-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  display: block;
}

/* 联系我们 */
.contact-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.contact-label {
  font-size: 26rpx;
  color: #999999;
  width: 160rpx;
  flex-shrink: 0;
}

.contact-value {
  font-size: 26rpx;
  color: #1A1A1A;
  flex: 1;
}

.contact-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  text-align: center;
}

.contact-btn::after {
  border: none;
}

/* Footer */
.footer {
  margin-top: 40rpx;
  padding: 0 24rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #CCCCCC;
  font-style: italic;
}
