/* pages/home/home.wxss - 极简主义 */

/* ===== 导航栏 ===== */
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
  background: #FFFFFF;
}

.nav-logo {
  width: 80rpx;
  height: 80rpx;
  margin-right: 32rpx;
  border-radius: 16rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

/* ===== 页面主体 ===== */
.page {
  background: #FFFFFF;
  min-height: 100vh;
}

/* ===== 日期 ===== */
.date-line {
  padding: 24rpx 32rpx 0;
}

.date-text {
  font-size: 26rpx;
  color: #BBBBBB;
  font-weight: 400;
}

/* ===== 板块标题 ===== */
.section-head {
  padding: 40rpx 32rpx 24rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A1A;
}

/* ===== 横向滚动卡片 ===== */
.scroll-area {
  padding-left: 32rpx;
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 8rpx;
}

.scroll-area::-webkit-scrollbar {
  display: none;
}

.scroll-card {
  display: inline-block;
  width: 520rpx;
  margin-right: 20rpx;
  vertical-align: top;
  white-space: normal;
}

.scroll-card-image {
  width: 100%;
  height: 340rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
}

.scroll-card-image-wide {
  width: 100%;
  border-radius: 20rpx;
  background: #F5F5F5;
}

.scroll-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #BBBBBB;
  margin-top: 16rpx;
  line-height: 1.4;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 公告居中 ===== */
.announcement-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
}

.announcement-card {
  width: 100%;
}

/* ===== 关于我们封面 ===== */
.about-wrap {
  padding: 0 32rpx;
}

.about-cover {
  width: 100%;
  height: 340rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
}

/* ===== 联系我们 ===== */
.contact-body {
  padding: 0 32rpx 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact-sub {
  font-size: 26rpx;
  color: #BBBBBB;
  flex: 1;
  margin-right: 24rpx;
}

.contact-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 28rpx;
  border: none;
  text-align: center;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-chat-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 24rpx;
  vertical-align: middle;
}

.contact-btn::after {
  border: none;
}
