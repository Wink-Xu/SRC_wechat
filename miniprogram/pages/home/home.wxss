/* pages/home/home.wxss */
.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* Banner */
.banner {
  background: #FFFFFF;
  padding: 80rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
}

.club-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.club-slogan {
  font-size: 26rpx;
  color: #999999;
}

/* Section */
.section {
  background: #FFFFFF;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.section-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  transition: transform 0.3s;
  transform: rotate(90deg);
}

.section-arrow.up {
  transform: rotate(-90deg);
}

.section-content {
  padding: 0 28rpx 32rpx;
}

.announce-content,
.about-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* 联系我们 */
.contact-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.contact-label {
  font-size: 28rpx;
  color: #999999;
  width: 160rpx;
  flex-shrink: 0;
}

.contact-value {
  font-size: 28rpx;
  color: #1A1A1A;
}

.contact-btn {
  margin-top: 24rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 12rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-btn::after {
  border: none;
}
