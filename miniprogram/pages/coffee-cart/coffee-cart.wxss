/* pages/coffee-cart/coffee-cart.wxss */
page {
  background: #F5F5F5;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 购物车列表 */
.cart-list {
  margin-bottom: 24rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F0F0;
}

.item-info {
  flex: 1;
  padding: 0 20rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-temp-tag {
  font-size: 22rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.item-qty {
  font-size: 24rpx;
  color: #999999;
}

.item-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.item-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1A1A1A;
}

.qty-num {
  width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

/* 支付方式 */
.payment-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
  display: block;
}

.payment-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-item {
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  display: flex;
  align-items: center;
}

.payment-item.active {
  background: #1A1A1A;
  color: #FFFFFF;
}

.balance-info {
  font-size: 24rpx;
  opacity: 0.8;
  margin-left: 8rpx;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666666;
  margin-right: 8rpx;
}

.total-price {
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.checkout-btn {
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  border: none;
}

/* 空状态 */
.empty-box {
  text-align: center;
  padding: 160rpx 0;
  color: #999999;
  font-size: 28rpx;
}