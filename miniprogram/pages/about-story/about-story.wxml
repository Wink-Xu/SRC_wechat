<view class="page">
  <image class="cover-image" src="{{coverImage || '/images/fengmianpic.jpg'}}" mode="widthFix" bindtap="previewCover"></image>

  <view class="content-section">
    <image class="logo-image" src="/images/piclogo.jpg" mode="widthFix"></image>

    <view class="story-paragraph" wx:for="{{storyParagraphs}}" wx:key="index">{{item}}</view>

    <!-- 那些一起奔跑的岁月 -->
    <view class="runner-years-section" wx:if="{{runnerYearsImages && runnerYearsImages.length > 0}}">
      <text class="runner-years-title">那些一起奔跑的岁月</text>
      <view class="runner-years-scroll">
        <view class="ry-card" wx:for="{{runnerYearsImages}}" wx:key="*this" bindtap="previewRunnerYearsImage" data-index="{{index}}">
          <image class="ry-image" src="{{item}}" mode="aspectFill"></image>
        </view>
      </view>
    </view>
  </view>
</view>
