/* pages/scan-checkin/scan-checkin.wxss - 简约风格 */

page {
  background: #F8F8F8;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 0;
}

/* 加载 */
.loading-box {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 错误状态 */
.error-box {
  display: flex;
  justify-content: center;
  padding: 200rpx 40rpx 0;
}

.error-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 60rpx 48rpx;
  text-align: center;
  width: 100%;
}

.error-icon-text {
  display: block;
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: #F5F5F5;
  border-radius: 50%;
  font-size: 48rpx;
  color: #999;
  font-weight: 600;
  margin: 0 auto 24rpx;
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

/* 标题区域 */
.hero-section {
  padding: 60rpx 40rpx 20rpx;
  text-align: center;
}

.hero-title {
  display: block;
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  display: block;
  font-size: 36rpx;
  color: #1A1A1A;
  font-weight: 600;
  line-height: 1.4;
}

/* 信息卡片 */
.info-card {
  margin: 20rpx 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.info-text {
  font-size: 28rpx;
  color: #4A4A4A;
}

/* 操作区 */
.action-section {
  padding: 0 32rpx;
}

/* 已签到卡片 */
.checked-in-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}

.check-icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #7BC67E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.check-mark {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.checked-in-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.checked-in-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 未报名卡片 */
.not-registered-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.not-reg-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.not-reg-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 签到按钮区域 */
.checkin-btn-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.checkin-prompt {
  display: block;
  font-size: 30rpx;
  color: #4A4A4A;
  margin-bottom: 48rpx;
}

/* 按钮通用 */
.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #1A1A1A;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-large {
  height: 112rpx;
  border-radius: 56rpx;
  font-size: 36rpx;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: 700;
}

.btn-secondary {
  background: #F5F5F5;
  color: #666;
}

.btn-secondary:active {
  background: #EEEEEE;
}
