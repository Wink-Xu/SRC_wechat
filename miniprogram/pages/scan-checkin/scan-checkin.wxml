<view class="container">
  <view wx:if="{{loading}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <block wx:elif="{{error}}">
    <view class="error-box">
      <view class="error-card">
        <text class="error-icon-text">!</text>
        <text class="error-text">{{error}}</text>
        <button class="btn btn-secondary" bindtap="goBack">返回</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{activity}}">
    <!-- 活动标题区域 -->
    <view class="hero-section">
      <text class="hero-title">活动签到</text>
      <text class="hero-subtitle">{{activity.title}}</text>
    </view>

    <!-- 活动信息卡片 -->
    <view class="info-card">
      <view class="info-row">
        <image class="info-icon" src="/images/time.png" mode="aspectFit"></image>
        <text class="info-text">{{activity.formattedTime}}</text>
      </view>
      <view class="info-row">
        <image class="info-icon" src="/images/location.png" mode="aspectFit"></image>
        <text class="info-text">{{activity.location}}</text>
      </view>
    </view>

    <!-- 签到操作区 -->
    <view class="action-section">
      <block wx:if="{{hasCheckedIn}}">
        <view class="checked-in-card">
          <view class="check-icon-circle">
            <text class="check-mark">✓</text>
          </view>
          <text class="checked-in-title">签到成功</text>
          <text class="checked-in-desc">{{activity.pointsText || '已完成签到'}}</text>
        </view>
      </block>

      <block wx:elif="{{!isRegistered}}">
        <view class="not-registered-card">
          <text class="not-reg-title">未报名此活动</text>
          <text class="not-reg-desc">请先报名后再签到</text>
          <button class="btn btn-primary" bindtap="goToRegister">去报名</button>
          <button class="btn btn-secondary" bindtap="goBack">返回</button>
        </view>
      </block>

      <block wx:else>
        <view class="checkin-btn-section">
          <text class="checkin-prompt">确认签到参加活动？</text>
          <button class="btn btn-primary btn-large" bindtap="confirmCheckIn">
            <text class="btn-icon">✓</text>
            <text>确认签到</text>
          </button>
          <button class="btn btn-secondary" bindtap="goBack">取消</button>
        </view>
      </block>
    </view>
  </block>
</view>
