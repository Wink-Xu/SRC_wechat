/* pages/admin-coffee-orders/admin-coffee-orders.wxss */
page {
  background: #F8F8F8;
}

.container {
  min-height: 100vh;
}

.filter-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 20rpx;
  gap: 16rpx;
}

.filter-tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  border-radius: 20rpx;
}

.filter-tab.active {
  background: #1A1A1A;
  color: #FFFFFF;
}

.order-list {
  padding: 20rpx;
}

.order-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 24rpx;
  color: #2E7D32;
}

.order-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.order-time {
  font-size: 24rpx;
  color: #999999;
}

.order-products {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.order-products text {
  display: block;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
}

.order-total {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.complete-btn {
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.loading-box, .empty-box {
  text-align: center;
  padding: 60rpx;
  color: #999999;
}