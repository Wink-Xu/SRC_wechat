/* pages/admin-coffee-orders/admin-coffee-orders.wxss */
page {
  background: #F8F8F8;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.container {
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  padding: 20rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 状态筛选 Tab */
.status-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 20rpx;
  gap: 16rpx;
  margin-top: 1rpx;
}

.tab-item {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.tab-item.active {
  background: #1A1A1A;
  color: #FFFFFF;
}

/* 日期筛选 */
.date-filter {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  padding: 20rpx;
  margin-top: 1rpx;
}

.date-picker {
  flex: 1;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333333;
}

.date-separator {
  font-size: 26rpx;
  color: #999999;
}

.date-clear {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-no {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

/* 状态标签 */
.status-tag {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.status-pending {
  background: #FFF3E0;
  color: #F57C00;
}

.status-processing {
  background: #E3F2FD;
  color: #1976D2;
}

.status-completed {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-cancelled {
  background: #F5F5F5;
  color: #999999;
}

.order-body {
  padding: 20rpx 0;
}

.order-info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.info-label {
  color: #999999;
  flex-shrink: 0;
  width: 100rpx;
}

.info-value {
  color: #333333;
  flex: 1;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  color: #666666;
}

.order-total {
  display: flex;
  align-items: center;
}

.total-label {
  font-size: 26rpx;
  color: #999999;
  margin-right: 8rpx;
}

.total-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* 订单操作按钮 */
.order-operation {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
  display: flex;
  justify-content: flex-end;
}

.op-btn {
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  border-radius: 24rpx;
  border: none;
}

.processing-btn {
  background: #1976D2;
  color: #FFFFFF;
}

.complete-btn {
  background: #2E7D32;
  color: #FFFFFF;
}

/* 导出按钮 */
.export-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.export-btn {
  width: 100%;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  padding: 28rpx 0;
  border-radius: 12rpx;
  border: none;
}

/* 加载和空状态 */
.loading-box, .empty-box {
  text-align: center;
  padding: 120rpx 32rpx;
  color: #999999;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
}
