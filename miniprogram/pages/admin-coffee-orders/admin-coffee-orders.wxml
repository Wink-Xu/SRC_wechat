<!--pages/admin-coffee-orders/admin-coffee-orders.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <view class="search-icon">🔍</view>
      <input class="search-input" placeholder="搜索订单号或用户昵称" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch"/>
    </view>
    <view class="filter-btn" bindtap="showFilter">
      <text>筛选</text>
      <view class="filter-icon">⚡</view>
    </view>
  </view>

  <!-- 状态筛选 Tab -->
  <scroll-view class="status-tabs" scroll-x enhanced show-scrollbar="false">
    <view class="tab-item {{statusFilter === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-status="all">全部</view>
    <view class="tab-item {{statusFilter === 'pending' ? 'active' : ''}}" bindtap="onFilterChange" data-status="pending">待处理</view>
    <view class="tab-item {{statusFilter === 'processing' ? 'active' : ''}}" bindtap="onFilterChange" data-status="processing">制作中</view>
    <view class="tab-item {{statusFilter === 'completed' ? 'active' : ''}}" bindtap="onFilterChange" data-status="completed">已完成</view>
    <view class="tab-item {{statusFilter === 'cancelled' ? 'active' : ''}}" bindtap="onFilterChange" data-status="cancelled">已取消</view>
  </scroll-view>

  <!-- 日期筛选 -->
  <view class="date-filter" wx:if="{{showDateFilter}}">
    <picker mode="date" value="{{startDate}}" end="{{endDate}}" bindchange="onStartDateChange">
      <view class="date-picker">
        <text>{{startDate || '开始日期'}}</text>
      </view>
    </picker>
    <text class="date-separator">至</text>
    <picker mode="date" value="{{endDate}}" start="{{startDate}}" end="{{maxDate}}" bindchange="onEndDateChange">
      <view class="date-picker">
        <text>{{endDate || '结束日期'}}</text>
      </view>
    </picker>
    <view class="date-clear" bindtap="clearDateFilter">
      <text>清除</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view wx:if="{{loading}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{orders.length === 0}}" class="empty-box">
    <text class="empty-icon">📦</text>
    <text class="empty-text">暂无订单</text>
  </view>

  <view wx:else class="order-list">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id">
      <view class="order-header" bindtap="goToDetail" data-id="{{item._id}}">
        <view class="header-left">
          <text class="order-no">{{item.order_no}}</text>
          <view class="status-tag status-{{item.status}}">
            {{item.statusText}}
          </view>
        </view>
        <text class="arrow-icon">›</text>
      </view>

      <view class="order-body" bindtap="goToDetail" data-id="{{item._id}}">
        <view class="order-info-row">
          <text class="info-label">用户：</text>
          <text class="info-value">{{item.user_nickname}}</text>
        </view>
        <view class="order-info-row">
          <text class="info-label">商品：</text>
          <text class="info-value">{{item.itemsText}}</text>
        </view>
        <view class="order-info-row">
          <text class="info-label">时间：</text>
          <text class="info-value">{{item.formattedTime}}</text>
        </view>
      </view>

      <view class="order-footer">
        <view class="order-actions">
          <view class="action-btn copy-btn" bindtap="copyOrderNo" data-no="{{item.order_no}}">
            <text>复制</text>
          </view>
          <view class="action-btn detail-btn" bindtap="goToDetail" data-id="{{item._id}}">
            <text>详情</text>
          </view>
        </view>
        <view class="order-total">
          <text class="total-label">实付：</text>
          <text class="total-price">￥{{item.total_amount / 100}}</text>
        </view>
      </view>

      <!-- 订单状态操作按钮 -->
      <view class="order-operation" wx:if="{{item.status === 'pending'}}">
        <button class="op-btn processing-btn" data-id="{{item._id}}" data-status="processing" bindtap="updateStatus">开始制作</button>
      </view>
      <view class="order-operation" wx:if="{{item.status === 'processing'}}">
        <button class="op-btn complete-btn" data-id="{{item._id}}" data-status="completed" bindtap="updateStatus">完成订单</button>
      </view>
    </view>
  </view>

  <!-- 导出按钮 -->
  <view class="export-section" wx:if="{{orders.length > 0}}">
    <button class="export-btn" bindtap="exportOrders">导出订单</button>
  </view>
</view>