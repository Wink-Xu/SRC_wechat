/* pages/admin-coffee/admin-coffee.wxss */
page {
  background: #F5F5F5;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 顶部标题栏 */
.header {
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.add-btn {
  background: #1A1A1A;
  color: #FFFFFF;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 32rpx;
  font-weight: 300;
}

.add-text {
  font-size: 26rpx;
}

/* 分类筛选 */
.category-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  margin-bottom: 16rpx;
  align-items: center;
}

.tab-item {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #666666;
  background: transparent;
  border-radius: 8rpx;
  flex: 0 0 auto;
}

.tab-item.active {
  background: #1A1A1A;
  color: #FFFFFF;
}

/* 商品列表 */
.product-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F5F5F5;
}

.product-content {
  flex: 1;
  min-width: 0;
}

.product-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.category-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #F5F5F5;
  color: #666666;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.product-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.status-tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
}

.status-tag.active {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-tag.inactive {
  background: #F5F5F5;
  color: #999999;
}

.product-action {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.icon-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
}

.edit-btn {
  background: #E3F2FD;
}

.edit-btn .icon {
  color: #1976D2;
  font-size: 28rpx;
  font-weight: 300;
}

.delete-btn {
  background: #FFEBEE;
}

.delete-btn .icon {
  color: #C62828;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}

/* 加载和空状态 */
.loading-box, .empty-box {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #999999;
  font-size: 28rpx;
}