<!--pages/admin-coffee/admin-coffee.wxml-->
<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <text class="header-title">咖啡管理</text>
    <view class="header-right">
      <!-- 营业状态开关 -->
      <view class="shop-status-switch {{isShopOpen ? 'active' : ''}}" bindtap="toggleShopStatus">
        <view class="switch-btn {{isShopOpen ? 'on' : 'off'}}"></view>
        <text class="switch-text">{{isShopOpen ? '营业中' : '已打烊'}}</text>
      </view>
    </view>
    <view class="add-btn" bindtap="goToAdd">
      <text class="add-icon">+</text>
      <text class="add-text">添加商品</text>
    </view>
  </view>

  <!-- 分类筛选 -->
  <view class="category-tabs">
    <view class="tab-item {{currentCategory === 'all' ? 'active' : ''}}" bindtap="selectCategory" data-category="all">
      <text>全部</text>
    </view>
    <view class="tab-item {{currentCategory === item.key ? 'active' : ''}}" wx:for="{{categories}}" wx:key="key" bindtap="selectCategory" data-category="{{item.key}}">
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view wx:if="{{loading}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{filteredProducts.length === 0}}" class="empty-box">
    <text>暂无商品</text>
  </view>

  <view wx:else class="product-list">
    <view class="product-item" wx:for="{{filteredProducts}}" wx:key="_id">
      <image class="product-image" src="{{item.display_image || '/images/coffee-default.png'}}" mode="aspectFill" bindtap="goToEdit" data-id="{{item._id}}"></image>
      <view class="product-content" bindtap="goToEdit" data-id="{{item._id}}">
        <view class="product-top">
          <text class="product-name">{{item.name}}</text>
          <view class="category-tag">{{getCategoryName(item.category)}}</view>
        </view>
        <text class="product-desc" wx:if="{{item.description}}">{{item.description}}</text>
        <view class="product-bottom">
          <text class="product-price">￥{{item.price / 100}}</text>
          <view class="status-tag {{item.is_available ? 'active' : 'inactive'}}">
            {{item.is_available ? '上架中' : '已下架'}}
          </view>
        </view>
      </view>
      <view class="product-action">
        <view class="icon-btn edit-btn" bindtap="goToEdit" data-id="{{item._id}}">
          <text class="icon">✎</text>
        </view>
        <view class="icon-btn delete-btn" bindtap="deleteProduct" data-id="{{item._id}}">
          <text class="icon">×</text>
        </view>
      </view>
    </view>
  </view>
</view>