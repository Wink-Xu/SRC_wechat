<!--pages/admin-coffee/admin-coffee.wxml-->
<view class="container">
  <view wx:if="{{loading}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <view class="add-btn" bindtap="goToAdd">+ 添加商品</view>

    <view wx:if="{{products.length === 0}}" class="empty-box">
      <text>暂无商品</text>
    </view>

    <view wx:else class="product-list">
      <view class="product-item" wx:for="{{products}}" wx:key="_id">
        <view class="product-info" bindtap="goToEdit" data-id="{{item._id}}">
          <text class="product-name">{{item.name}}</text>
          <text class="product-category">
            {{item.category === 'americano' ? '美式' : item.category === 'latte' ? '拿铁' : item.category === 'special' ? '特调' : item.category === 'decaf' ? '无咖啡因' : item.category === 'pour_over' ? '单品手冲' : '充值套餐'}}
          </text>
          <text class="product-price">￥{{item.price / 100}}</text>
        </view>
        <view class="product-actions">
          <text class="status-tag {{item.is_available ? 'active' : 'inactive'}}" bindtap="toggleStatus" data-id="{{item._id}}">
            {{item.is_available ? '上架中' : '已下架'}}
          </text>
        </view>
      </view>
    </view>
  </view>
</view>