/* pages/admin-home/admin-home.wxss */
page {
  background: #F5F5F5;
}

.container {
  min-height: 100vh;
  padding: 20rpx 24rpx 100rpx;
}

.loading-box {
  text-align: center;
  padding: 120rpx;
  color: #999;
  font-size: 28rpx;
}

.form-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: #999999;
  padding: 0 8rpx 16rpx;
  font-weight: 500;
}

.section-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.image-wrapper {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.image-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.image-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

.image-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #E5E5E5;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  line-height: 1;
}

.upload-hint {
  font-size: 24rpx;
  color: #CCCCCC;
}

.save-btn {
  width: 100%;
  height: 80rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  opacity: 0.5;
}
